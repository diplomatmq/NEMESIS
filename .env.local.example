# ============================================
# NEMESIS - Production Environment (Server)
# ============================================
# СКОПИРУЙТЕ этот файл в .env.local на СЕРВЕРЕ
# и замените все значения на реальные!
# ============================================

# Telegram Bot Configuration
# ⚠️ ВАЖНО: Замените токен через @BotFather если он был скомпрометирован!
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_HERE
BOT_USERNAME=nemesis_robot

# Database Configuration (для Docker контейнера)
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@postgres:5432/nemesis_game
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_NAME=nemesis_game

# Redis Configuration (для Docker контейнера)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Game Configuration
COOLDOWN_MINUTES=10
STARS_PRICE=1

# Server Configuration
PORT=3000
NODE_ENV=production
