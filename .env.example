# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/nemesis_game
DB_HOST=localhost
DB_PORT=5432
DB_USER=,kkkkkkkk
DB_PASSWORD=your_password
DB_NAME=nemesis_game

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Game Configuration
COOLDOWN_MINUTES=10
STARS_PRICE=1

# Server Configuration
PORT=3000
NODE_ENV=development

# Webhook Configuration (optional, НЕ нужен для разработки!)
# Webhook используется только в продакшене для получения обновлений от Telegram
# Для локальной разработки используется long polling - ничего настраивать не нужно
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret
