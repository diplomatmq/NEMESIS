# ============================================
# NEMESIS Tower Game - Environment Variables
# ============================================
# 
# ВАЖНО: Этот файл - ШАБЛОН. Для работы:
# 1. Скопируйте его в .env.local: cp .env.example .env.local
# 2. Замените все значения your_*_here на реальные
# 3. НИКОГДА не коммитьте .env.local в git!
#
# ============================================

# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Database Configuration (PostgreSQL)
# Для Docker используйте: postgres (как хост)
# Для локальной разработки: localhost
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/nemesis_game
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=nemesis_game

# Redis Configuration
# Для Docker используйте: redis (как хост)
# Для локальной разработки: localhost
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Game Configuration
COOLDOWN_MINUTES=5
STARS_PRICE=1

# Server Configuration
PORT=3000
NODE_ENV=production

# Mini App Configuration (Python server)
# Публичный URL мини-приложения (https обязателен для Telegram)
WEBAPP_URL=https://your-domain.com
# Короткое имя Mini App из @BotFather (создаётся через /newapp)
APP_NAME=game
# Порт Python сервера
MINIAPP_PORT=8080

# Channel и Support
# ID/username канала для квеста подписки (опционально, например @yourchannel)
CHANNEL=
# URL канала поддержки (показывается в /terms и /paysupport)
SUPPORT_URL=https://t.me/yourchannel

# Stars Configuration
# Тестовый режим Stars (0 = реальные Stars, 1 = тест). Владельцы могут менять в игре
STARS_TEST=0

# Time Zone и Anti-Cheat
# Часовой пояс для статистики и дайджестов (часы от UTC, например 3 для МСК)
AC_TZ=3
# Час отправки античит дайджеста (0-23)
AC_DIGEST_HOUR=12

# Reminders (Напоминания об отдыхе)
# Максимум одно напоминание за N часов
REMIND_GAP_H=8
# Только после M минут неактивности
REMIND_AWAY_MIN=30

# ВАЖНО: Мини-приложение использует ту же PostgreSQL базу данных что и основной бот
# Таблицы мини-приложения имеют префикс 'app_' чтобы избежать конфликтов

# Admin IDs (comma-separated Telegram user IDs)
ADMIN_IDS=678418106,793216884

# Webhook Configuration (ОПЦИОНАЛЬНО)
# Используется только в продакшене для webhook-режима
# Для разработки используется long polling - оставьте закомментированным
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret
