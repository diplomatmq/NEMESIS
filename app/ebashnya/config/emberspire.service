# /etc/systemd/system/emberspire.service
[Unit]
Description=Ebashnya (Emberspire) game server and Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/emberspire
EnvironmentFile=/opt/emberspire/emberspire.env
ExecStart=/usr/bin/python3 /opt/emberspire/server.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
